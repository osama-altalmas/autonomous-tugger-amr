<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="autonomous_tugger">

  <!-- VEHICLE PARAMETERS -->

  <xacro:property name="body_length" value="0.90"/>
  <xacro:property name="body_width" value="0.60"/>

  <xacro:property name="wheelbase" value="0.58"/>
  <xacro:property name="wheel_y" value="0.22"/>

  <xacro:property name="wheel_radius" value="0.055"/>
  <xacro:property name="wheel_width" value="0.040"/>
  <xacro:property name="wheel_mass" value="1.0"/>

  <xacro:property name="chassis_mass" value="45.0"/>


  <!-- MATERIALS -->

  <material name="body_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <material name="gap_dark">
    <color rgba="0.06 0.06 0.06 1.0"/>
  </material>

  <material name="sensor_red">
    <color rgba="0.85 0.02 0.02 1.0"/>
  </material>

  <material name="camera_black">
    <color rgba="0.005 0.005 0.005 1.0"/>
  </material>


  <!-- BASE FOOTPRINT -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint"
         type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin xyz="0 0 0.100"
            rpy="0 0 0"/>

  </joint>


  <!-- MAIN BODY -->

  <link name="base_link">

    <!-- LOWER WHITE FILLETED LAYER -->
    <visual name="bottom_layer">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://tugger_description/meshes/filleted_body.stl"/>
      </geometry>
      <material name="body_white"/>
    </visual>


    <!-- SMALL RECESSED DARK GAP -->

    <visual name="middle_gap">

      <origin xyz="0 0 0.0475"
              rpy="0 0 0"/>

      <geometry>
        <mesh filename="package://tugger_description/meshes/filleted_middle.stl"/>
      </geometry>

      <material name="gap_dark"/>

    </visual>


    <!-- UPPER WHITE FILLETED LAYER -->

    <visual name="top_layer">

      <origin xyz="0 0 0.095"
              rpy="0 0 0"/>

      <geometry>
        <mesh filename="package://tugger_description/meshes/filleted_body.stl"/>
      </geometry>

      <material name="body_white"/>

    </visual>


    <!-- SIMPLE COLLISION -->
    <collision>
      <origin xyz="0 0 0.0475" rpy="0 0 0"/>
      <geometry>
        <box size="0.88 0.58 0.15"/>
      </geometry>
    </collision>


    <inertial>

      <origin xyz="0 0 0.0475"
              rpy="0 0 0"/>

      <mass value="${chassis_mass}"/>

      <inertia
        ixx="1.25"
        ixy="0"
        ixz="0"
        iyy="2.90"
        iyz="0"
        izz="3.70"/>

    </inertial>

  </link>


  <!-- STEERED WHEEL MACRO -->

  <xacro:macro name="steered_wheel"
               params="prefix x y">

    <link name="${prefix}_steering_link">

      <inertial>

        <mass value="0.3"/>

        <inertia
          ixx="0.0005"
          ixy="0"
          ixz="0"
          iyy="0.0005"
          iyz="0"
          izz="0.0005"/>

      </inertial>

    </link>


    <joint name="${prefix}_steering_joint"
           type="revolute">

      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>

      <origin xyz="${x} ${y} -0.045"
              rpy="0 0 0"/>

      <axis xyz="0 0 1"/>

      <!-- 54 degrees: turning in place needs atan(0.29/0.22) = 52.8 degrees
           per wheel; car-like driving is limited to 45 degrees by the
           4WS controller. -->
      <limit
        lower="-0.9425"
        upper="0.9425"
        effort="500"
        velocity="1.5"/>

    </joint>


    <link name="${prefix}_wheel_link">

      <visual>

        <origin xyz="0 0 0"
                rpy="1.5708 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

        <material name="black"/>

      </visual>


      <!-- Contact shape: a sphere of the wheel radius, so the simulated
           contact point is the centre of the tyre patch, directly under the
           steering axis, as on the real wheel. A cylinder touches the
           floor at one rim edge in Gazebo (DART): steering at standstill
           then rolled the robot about that edge point, about 15 mm per
           50 degrees of steering, unseen by odometry. The visual stays a
           cylinder; the clearance model bounds the wheel by a 75 mm box. -->
      <collision>

        <origin xyz="0 0 0"
                rpy="0 0 0"/>

        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>

      </collision>


      <inertial>

        <mass value="${wheel_mass}"/>

        <inertia
          ixx="${(1.0/12.0) * wheel_mass *
                 (3*wheel_radius*wheel_radius +
                  wheel_width*wheel_width)}"
          ixy="0"
          ixz="0"
          iyy="${0.5 * wheel_mass *
                 wheel_radius*wheel_radius}"
          iyz="0"
          izz="${(1.0/12.0) * wheel_mass *
                 (3*wheel_radius*wheel_radius +
                  wheel_width*wheel_width)}"/>

      </inertial>

    </link>


    <joint name="${prefix}_wheel_joint"
           type="continuous">

      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_wheel_link"/>

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>


  <!-- GAZEBO WHEEL CONTACT / FRICTION -->

  <xacro:macro name="wheel_gazebo_friction" params="prefix">

    <gazebo reference="${prefix}_wheel_link">

      <!-- fdir1 is expressed in the wheel link frame, which spins with
           the wheel; only the axle (y) keeps its direction while rolling.
           mu1 acts along the axle (sideways), mu2 along the rolling
           direction. With fdir1 = x the grip direction turned with the
           wheel's spin angle, so the friction was effectively random. -->
      <mu1>0.20</mu1>
      <mu2>1.0</mu2>

      <fdir1>0 1 0</fdir1>


    </gazebo>

  </xacro:macro>


  <xacro:wheel_gazebo_friction prefix="front_left"/>
  <xacro:wheel_gazebo_friction prefix="front_right"/>
  <xacro:wheel_gazebo_friction prefix="rear_left"/>
  <xacro:wheel_gazebo_friction prefix="rear_right"/>



  <!-- FOUR-WHEEL STEERING -->

  <xacro:steered_wheel
    prefix="front_left"
    x="${wheelbase/2}"
    y="${wheel_y}"/>

  <xacro:steered_wheel
    prefix="front_right"
    x="${wheelbase/2}"
    y="${-wheel_y}"/>

  <xacro:steered_wheel
    prefix="rear_left"
    x="${-wheelbase/2}"
    y="${wheel_y}"/>

  <xacro:steered_wheel
    prefix="rear_right"
    x="${-wheelbase/2}"
    y="${-wheel_y}"/>


  <!-- FRONT-LEFT HEMISPHERICAL LIDAR -->

  <link name="front_left_lidar_link">

    <visual>

      <geometry>
        <sphere radius="0.040"/>
      </geometry>

      <material name="sensor_red"/>

    </visual>


    <inertial>

      <mass value="0.15"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <joint name="front_left_lidar_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="front_left_lidar_link"/>

    <!-- Safety laser scanner (SICK nanoScan3 class) on the front-left corner
         of the middle core, between the decks and flush with their edge. It
         faces diagonally out, so the 90 degrees the core blocks fall in its
         dead zone; its field covers the whole front and left side. -->
    <origin xyz="0.410 0.260 0.0275"
            rpy="0 0 0.7854"/>

  </joint>


  <!-- REAR-RIGHT HEMISPHERICAL LIDAR -->

  <link name="rear_right_lidar_link">

    <visual>

      <geometry>
        <sphere radius="0.040"/>
      </geometry>

      <material name="sensor_red"/>

    </visual>


    <inertial>

      <mass value="0.15"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <joint name="rear_right_lidar_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="rear_right_lidar_link"/>

    <!-- Second safety scanner at the rear-right corner: rear and right. -->
    <origin xyz="-0.410 -0.260 0.0275"
            rpy="0 0 -2.3562"/>

  </joint>


  <!-- BUMPER / SAFETY STRIP: any contact of the chassis with the world is an
       emergency stop (latched until reset), like the KMP 600P safety strip.
       It senses on the chassis collision itself, so the robot's size and
       every clearance check are unchanged. -->
  <gazebo reference="base_link">
    <sensor name="bumper" type="contact">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/tugger/bumper/contacts</topic>
      <contact>
        <collision>base_footprint_fixed_joint_lump__base_link_collision</collision>
      </contact>
    </sensor>
  </gazebo>


  <!-- GAZEBO LIDAR SENSORS -->

  <gazebo reference="front_left_lidar_link">
    <sensor name="front_left_lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <!-- nanoScan3 class: 275 degrees, 25 Hz (40 ms scan); 0.5 degree
           steps here (the device has 0.17) to keep the simulation fast;
           1 cm range noise (ASSUMED, within the device's tolerance). -->
      <update_rate>25</update_rate>
      <topic>front_left/scan</topic>
      <gz_frame_id>front_left_lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>551</samples>
            <resolution>1</resolution>
            <min_angle>-2.39983</min_angle>
            <max_angle>2.39983</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>40.0</max>
          <resolution>0.005</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="rear_right_lidar_link">
    <sensor name="rear_right_lidar_sensor" type="gpu_lidar">
      <always_on>true</always_on>
      <!-- nanoScan3 class: 275 degrees, 25 Hz (40 ms scan); 0.5 degree
           steps here (the device has 0.17) to keep the simulation fast;
           1 cm range noise (ASSUMED, within the device's tolerance). -->
      <update_rate>25</update_rate>
      <topic>rear_right/scan</topic>
      <gz_frame_id>rear_right_lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>551</samples>
            <resolution>1</resolution>
            <min_angle>-2.39983</min_angle>
            <max_angle>2.39983</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>40.0</max>
          <resolution>0.005</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>


  <!-- FRONT CAMERA -->

  <link name="front_camera_link">

    <visual>

      <geometry>
        <box size="0.005 0.080 0.025"/>
      </geometry>

      <material name="camera_black"/>

    </visual>


    <inertial>

      <mass value="0.10"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <joint name="front_camera_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="front_camera_link"/>

    <origin xyz="0.460 0 0.095"
            rpy="0 0 0"/>

  </joint>


  <!-- REAR CAMERA -->

  <link name="rear_camera_link">

    <visual>

      <geometry>
        <box size="0.005 0.080 0.025"/>
      </geometry>

      <material name="camera_black"/>

    </visual>


    <inertial>

      <mass value="0.10"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <joint name="rear_camera_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="rear_camera_link"/>

    <origin xyz="-0.460 0 0.095"
            rpy="0 0 3.14159"/>

  </joint>

  <!-- Thin, 50 mm square QR camera below the intact lower chassis.  Its
       optical origin remains centred over base_footprint / the lift platform. -->
  <link name="downward_camera_link">
    <visual>
      <geometry><box size="0.050 0.050 0.005"/></geometry>
      <material name="camera_black"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="downward_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="downward_camera_link"/>
    <!-- Mounted just below the intact lower chassis: the lens is 60 mm above
         the floor in the normal Gazebo resting pose, clear of the chassis
         underside while retaining a 330 mm-wide 140-degree field of view. -->
    <origin xyz="0 0 -0.040" rpy="0 1.57079632679 0"/>
  </joint>



  <!-- GAZEBO FRONT 3D (DEPTH) CAMERA: Intel RealSense D435 class,
       87 x 58 degrees, used 0.3-4 m; about 1 cm depth noise (ASSUMED,
       RealSense quotes under 2 % at 2 m). Feeds the safety monitor with
       obstacles above and beside the scanner plane, as on the KMP 600P. -->

  <gazebo reference="front_camera_link">
    <sensor name="front_depth" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>front_depth</topic>
      <gz_frame_id>front_camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <!-- 160 x 120 at 10 Hz in simulation (rendering cost); a 5 cm object
             at 3 m still spans over 2 pixels. The device runs 424 x 240 up. -->
        <image>
          <width>160</width>
          <height>120</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>4.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.3</near>
            <far>4.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>


  <!-- GAZEBO REAR 3D (DEPTH) CAMERA: Intel RealSense D435 class,
       87 x 58 degrees, used 0.3-4 m; about 1 cm depth noise (ASSUMED,
       RealSense quotes under 2 % at 2 m). Feeds the safety monitor with
       obstacles above and beside the scanner plane, as on the KMP 600P. -->

  <gazebo reference="rear_camera_link">
    <sensor name="rear_depth" type="rgbd_camera">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>rear_depth</topic>
      <gz_frame_id>rear_camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>
        <!-- 160 x 120 at 10 Hz in simulation (rendering cost); a 5 cm object
             at 3 m still spans over 2 pixels. The device runs 424 x 240 up. -->
        <image>
          <width>160</width>
          <height>120</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>4.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.3</near>
            <far>4.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="downward_camera_link">
    <sensor name="downward_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/downward_camera/image_raw</topic>
      <camera>
        <horizontal_fov>2.44346</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.01</near><far>0.50</far></clip>
        <!-- Typical machine-vision sensor noise. -->
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
      </camera>
    </sensor>
  </gazebo>


  <!-- IMU -->

  <link name="imu_link"/>

  <joint name="imu_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="imu_link"/>

    <origin xyz="0 0 0"
            rpy="0 0 0"/>

  </joint>


  <!-- GAZEBO IMU SENSOR -->

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <!-- Industrial MEMS IMU (Bosch BMI088 class): gyro 0.014 deg/s/sqrt(Hz),
           accel 175 ug/sqrt(Hz) at 100 Hz. -->
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
    <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0024</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0024</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0024</stddev>
            </noise>
          </z>
        </angular_velocity>

        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.017</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>


  <!-- HITCH -->

  <link name="hitch_link"/>

  <joint name="hitch_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="hitch_link"/>

    <origin xyz="-0.48 0 -0.02"
            rpy="0 0 0"/>

  </joint>



  <!-- LIFTING PLATFORM -->

  <link name="lift_platform_link">

    <visual>
      <geometry>
        <box size="0.50 0.32 0.015"/>
      </geometry>

      <material name="gap_dark"/>
    </visual>


    <collision>
      <geometry>
        <box size="0.50 0.32 0.015"/>
      </geometry>
    </collision>


    <inertial>
      <mass value="3.0"/>

      <inertia
        ixx="0.02566"
        ixy="0"
        ixz="0"
        iyy="0.06256"
        iyz="0"
        izz="0.08810"/>
    </inertial>

  </link>


  <!-- TOP QR READER: upward camera in the lift platform; reads the cargo's
       identity tag from below before lifting (KMP 600P style). -->
  <link name="top_qr_camera_link"/>
  <joint name="top_qr_camera_joint" type="fixed">
    <parent link="lift_platform_link"/>
    <child link="top_qr_camera_link"/>
    <origin xyz="0 0 0.0085" rpy="0 -1.57079632679 0"/>
  </joint>
  <gazebo reference="top_qr_camera_link">
    <sensor name="top_qr_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <topic>/top_qr_camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.005</near><far>0.30</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
      </camera>
    </sensor>
  </gazebo>


  <joint name="lift_joint"
         type="prismatic">

    <parent link="base_link"/>
    <child link="lift_platform_link"/>

    <!--
      Lowered position:
      upper body top = 0.1225 m
      platform thickness = 0.015 m
      platform center = 0.1300 m
    -->

    <origin xyz="0 0 0.130"
            rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <!--
      Operating range is 0.002-0.1075 m (lift_geometry.py). The hard stops sit
      outside it and the servo effort is unbounded: in DART a joint that comes
      to rest on a limit under a velocity limit latches there and ignores all
      later commands (gazebosim/gz-sim#2785, maintainer-recommended model).
    -->
    <limit
      lower="-0.05"
      upper="0.200"
      effort="1e9"
      velocity="0.05"/>

  </joint>


  <!-- ROS 2 CONTROL -->

  <ros2_control name="GazeboSimSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="front_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_steering_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


    <!-- Front-wheel traction interfaces. All four wheels are driven: when
         turning in place the rear pair alone pushes the robot sideways (their
         side components add up); the front pair cancels it, as on real
         turn-in-place platforms. In car-like driving each front wheel turns
         at its own side's rear wheel speed (counter-phase symmetry). -->

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


    <!-- Lift state interface -->

    <joint name="lift_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>


    <!-- Rear-wheel traction interfaces -->

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>


  <!-- GAZEBO ROS 2 CONTROL -->

  <gazebo>

    <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>$(find tugger_gazebo)/config/controllers.yaml</parameters>

    </plugin>

  </gazebo>

  <!-- Cargo coupling is intentionally command-driven; it is inactive until
       the operator panel emits an attach topic in the Gazebo simulation. -->
  <gazebo>
    <plugin filename="tugger_guarded_cargo_joint"
            name="tugger_gazebo::GuardedCargoJoint">
      <parent_link>lift_platform_link</parent_link>
      <child_model>cargo_station_0_stand</child_model>
      <child_link>stand_link</child_link>
      <attach_topic>/cargo/station_0/attach</attach_topic>
      <detach_topic>/cargo/station_0/detach</detach_topic>
      <output_topic>/cargo/station_0/state</output_topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="tugger_guarded_cargo_joint"
            name="tugger_gazebo::GuardedCargoJoint">
      <parent_link>lift_platform_link</parent_link>
      <child_model>cargo_station_3_stand</child_model>
      <child_link>stand_link</child_link>
      <attach_topic>/cargo/station_3/attach</attach_topic>
      <detach_topic>/cargo/station_3/detach</detach_topic>
      <output_topic>/cargo/station_3/state</output_topic>
    </plugin>
  </gazebo>

</robot>
